# Management database. SQLite is the zero-setup default; production can use
# mysql+asyncmy://user:password@host:3306/saa_data_agent?charset=utf8mb4
DATAAGENT_MANAGEMENT_DATABASE_URL=sqlite+aiosqlite:///./data/dataagent.db
DATAAGENT_DATABASE_ECHO=false

# Industrial Dashboard uses the verified read-only PdM mirror by default.
# Override with mysql+pymysql://user:password@host:3306/industrial_pdm when needed.
DATAAGENT_DASHBOARD_DATABASE_URL=sqlite:///./examples/industrial-pdm/generated/runtime/industrial_pdm.sqlite
DATAAGENT_DASHBOARD_QUERY_TIMEOUT_SECONDS=30
DATAAGENT_DASHBOARD_TELEMETRY_MAX_POINTS=500

# Report scheduling is opt-in. Calendar periods are pinned to metric definitions.
DATAAGENT_REPORT_SCHEDULER_ENABLED=false
DATAAGENT_REPORT_SCHEDULER_POLL_SECONDS=30

# Redis is a hot cache; MySQL/SQLite remains the durable source of truth.
# Docker Compose overrides the URL to redis://redis:6379/0 and requires it.
# Direct Windows/WSL runs may leave URL empty to disable the cache.
DATAAGENT_REDIS_URL=
DATAAGENT_REDIS_PASSWORD=dataagent
DATAAGENT_REDIS_REQUIRED=false
DATAAGENT_REDIS_PORT=16379
DATAAGENT_REDIS_KEY_PREFIX=dataagent
DATAAGENT_REDIS_CONVERSATION_TTL_SECONDS=3600
DATAAGENT_REDIS_CHAT_TTL_SECONDS=300
DATAAGENT_REDIS_CHECKPOINT_TTL_SECONDS=3600
DATAAGENT_REDIS_CONNECT_TIMEOUT_SECONDS=1
DATAAGENT_REDIS_SOCKET_TIMEOUT_SECONDS=1
DATAAGENT_REDIS_RETRY_INTERVAL_SECONDS=5
DATAAGENT_REDIS_LOCK_TIMEOUT_SECONDS=15
DATAAGENT_REDIS_LOCK_WAIT_SECONDS=5

# Docker Compose development databases. Change every password outside local demo.
DATAAGENT_MYSQL_ROOT_PASSWORD=root
DATAAGENT_MYSQL_PASSWORD=dataagent
DATAAGENT_MYSQL_MANAGEMENT_PORT=13307
DATAAGENT_DEMO_MYSQL_PASSWORD=root
DATAAGENT_DEMO_MYSQL_PORT=13306
DATAAGENT_DEMO_POSTGRES_PASSWORD=postgres
DATAAGENT_DEMO_POSTGRES_PORT=15432

# Optional Docker GPU runtime. Match the wheel and driver to the target machine.
# This example is the official CPython 3.11 Linux x86_64 CUDA 12.4 wheel.
DATAAGENT_TORCH_WHEEL_URL=https://download-r2.pytorch.org/whl/cu124/torch-2.6.0%2Bcu124-cp311-cp311-linux_x86_64.whl
DATAAGENT_PYPI_INDEX_URL=https://pypi.org/simple

# Model registry: database (normal) or mock (deterministic local demo/tests).
DATAAGENT_MODEL_MODE=database
DATAAGENT_MODEL_HTTP_TIMEOUT_SECONDS=120
# Optional JSON list, in order. Same CHAT endpoint/credentials/parameters only.
# Timeout/408/429/5xx advance to the next candidate before repeating a model.
# Keep [] unless candidates have been verified on the configured endpoint.
DATAAGENT_CHAT_FALLBACK_MODELS=[]
# Explicit provider/model capabilities; unknown pairs receive no extra options.
# Raw HTTP example: [{"endpoint_host":"dashscope.aliyuncs.com","model":"your-model","enable_thinking":false}]
# A verified profile may set purpose_options, e.g. report-review with bounded thinking.
# Options remain scoped to that endpoint/model/task; never leak to other candidates.
DATAAGENT_CHAT_REQUEST_PROFILES=[]
# Per-purpose output allowance and TOTAL wall-clock limit (including repair/failover).
DATAAGENT_CHAT_TASK_BUDGETS={}
DATAAGENT_CHAT_COMPLETION_TIMEOUT_SECONDS=300
DATAAGENT_CHART_SELECTION_RETRIES=1
DATAAGENT_REPORT_REVISION_RETRIES=1
DATAAGENT_REPORT_CALCULATION_RETRIES=1
# Reports must retain all supplied evidence; too-large input fails explicitly.
DATAAGENT_CHAT_REQUIRE_FULL_CONTEXT=["report","report-review","report-calculations"]
# Set this to the smallest context window among active CHAT models. maxTokens in
# model management is the output allowance; the remaining window is input.
DATAAGENT_CHAT_CONTEXT_WINDOW_TOKENS=32768
DATAAGENT_CHAT_CONTEXT_SAFETY_TOKENS=512
DATAAGENT_CHAT_CONTEXT_OVERFLOW_RETRIES=2
DATAAGENT_CHAT_CONTEXT_RETRY_RATIO=0.5
DATAAGENT_CONVERSATION_CONTEXT_MAX_TOKENS=4096

# Embedding source: database preserves the upstream model-management behavior.
# local_bge_m3 enables the optional local BAAI/bge-m3 dense+sparse encoder.
DATAAGENT_EMBEDDING_MODE=database
DATAAGENT_LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
DATAAGENT_LOCAL_EMBEDDING_DEVICE=auto
DATAAGENT_LOCAL_EMBEDDING_USE_FP16=true
DATAAGENT_LOCAL_EMBEDDING_BATCH_SIZE=4
DATAAGENT_LOCAL_EMBEDDING_QUERY_MAX_LENGTH=512
DATAAGENT_LOCAL_EMBEDDING_PASSAGE_MAX_LENGTH=8192
DATAAGENT_LOCAL_EMBEDDING_CACHE_DIR=./data/models

# RAG backends: simple, elasticsearch, milvus.
DATAAGENT_VECTOR_STORE_TYPE=simple
DATAAGENT_VECTOR_FILE_PATH=./data/vectorstore.json
DATAAGENT_VECTOR_EMBEDDING_DIMENSION=0
DATAAGENT_VECTOR_TABLE_TOP_K=10
DATAAGENT_VECTOR_TABLE_THRESHOLD=0.2
DATAAGENT_VECTOR_DEFAULT_TOP_K=8
DATAAGENT_VECTOR_DEFAULT_THRESHOLD=0.4
DATAAGENT_VECTOR_BATCH_DELETE_LIMIT=5000
DATAAGENT_VECTOR_ENABLE_HYBRID_SEARCH=false
DATAAGENT_VECTOR_HYBRID_TIMEOUT_MS=3000
DATAAGENT_EMBEDDING_BATCH_MAX_TOKENS=8000
DATAAGENT_EMBEDDING_BATCH_RESERVE_RATIO=0.2
DATAAGENT_EMBEDDING_BATCH_MAX_ITEMS=10
DATAAGENT_ELASTICSEARCH_URL=http://localhost:9200
DATAAGENT_ELASTICSEARCH_INDEX=spring-ai-document-index
DATAAGENT_ELASTICSEARCH_MIN_SCORE=0.5
DATAAGENT_MILVUS_URI=http://localhost:19530
DATAAGENT_MILVUS_COLLECTION=dataagent_documents
DATAAGENT_MILVUS_HYBRID_RRF_K=60
DATAAGENT_MILVUS_HYBRID_CANDIDATE_MULTIPLIER=16

# File storage: local or oss.
DATAAGENT_FILE_STORAGE_TYPE=local
DATAAGENT_FILE_PATH=./uploads
DATAAGENT_FILE_PATH_PREFIX=data-agent
DATAAGENT_FILE_URL_PREFIX=/uploads
DATAAGENT_FILE_MAX_SIZE=10485760
DATAAGENT_FILE_IMAGE_SIZE=2097152
DATAAGENT_OSS_ENDPOINT=
DATAAGENT_OSS_ACCESS_KEY_ID=
DATAAGENT_OSS_ACCESS_KEY_SECRET=
DATAAGENT_OSS_BUCKET_NAME=
DATAAGENT_OSS_CUSTOM_DOMAIN=

# Optional Apache Tika HTTP endpoint for broad document-format parity.
DATAAGENT_TIKA_URL=http://tika:9998
DATAAGENT_TIKA_REQUIRED=false

# Python sandbox. No local-process fallback is implemented.
DATAAGENT_SANDBOX_DOCKER_HOST=
DATAAGENT_SANDBOX_IMAGE=agentscope-registry.ap-southeast-1.cr.aliyuncs.com/agentscope/runtime-sandbox-base:latest
DATAAGENT_SANDBOX_MAX_CONCURRENCY=4
DATAAGENT_SANDBOX_QUEUE_CAPACITY=10
DATAAGENT_SANDBOX_MAX_CONNECTIONS=4096
DATAAGENT_SANDBOX_CODE_TIMEOUT_SECONDS=60
DATAAGENT_SANDBOX_DEPENDENCY_TIMEOUT_SECONDS=180
DATAAGENT_SANDBOX_LIMIT_MEMORY_MB=500
DATAAGENT_SANDBOX_CPU_CORES=1.0
DATAAGENT_SANDBOX_MAX_CODE_BYTES=262144
DATAAGENT_SANDBOX_MAX_INPUT_BYTES=10485760
DATAAGENT_SANDBOX_MAX_STDOUT_BYTES=1048576
DATAAGENT_SANDBOX_MAX_STDERR_BYTES=262144
DATAAGENT_SANDBOX_MAX_METADATA_BYTES=8192
DATAAGENT_SANDBOX_MAX_DEPENDENCIES=20
DATAAGENT_SANDBOX_PACKAGE_INDEX_URL=https://pypi.org/simple

# Workflow behavior.
DATAAGENT_MAX_SQL_RETRY_COUNT=10
DATAAGENT_MAX_PLAN_REPAIR_COUNT=2
DATAAGENT_MAX_HUMAN_REPAIR_COUNT=3
DATAAGENT_PYTHON_MAX_TRIES_COUNT=5
DATAAGENT_SQL_QUERY_TIMEOUT_SECONDS=30
DATAAGENT_SQL_MAX_ROWS=1000
DATAAGENT_JDBC_H2_DRIVER_CLASS=org.h2.Driver
DATAAGENT_JDBC_H2_JARS=
DATAAGENT_JDBC_DAMENG_DRIVER_CLASS=dm.jdbc.driver.DmDriver
DATAAGENT_JDBC_DAMENG_JARS=
DATAAGENT_MAX_TURN_HISTORY=5
DATAAGENT_MAX_PLAN_LENGTH=2000
DATAAGENT_ENABLE_SQL_RESULT_CHART=true
DATAAGENT_ENRICH_SQL_RESULT_TIMEOUT_MS=15000

# Lost background-job recovery. A PROCESSING job is retried only after it is
# stale, preventing a long document embedding from being executed twice.
DATAAGENT_EMBEDDING_RECOVERY_INITIAL_DELAY_SECONDS=300
DATAAGENT_EMBEDDING_RECOVERY_INTERVAL_SECONDS=300
DATAAGENT_EMBEDDING_PROCESSING_STALE_SECONDS=600
DATAAGENT_RESOURCE_CLEANUP_STALE_SECONDS=1800

# Report resources.
DATAAGENT_REPORT_MARKED_URL=https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/marked/12.0.0/marked.min.js
DATAAGENT_REPORT_ECHARTS_URL=https://mirrors.sustech.edu.cn/cdnjs/ajax/libs/echarts/5.5.0/echarts.min.js

# Langfuse OTLP.
DATAAGENT_LANGFUSE_ENABLED=false
DATAAGENT_LANGFUSE_HOST=
DATAAGENT_LANGFUSE_PUBLIC_KEY=
DATAAGENT_LANGFUSE_SECRET_KEY=

# Web/MCP.
DATAAGENT_HOST=0.0.0.0
DATAAGENT_PORT=8065
DATAAGENT_CORS_ORIGINS=["*"]
DATAAGENT_MCP_HOST=0.0.0.0
DATAAGENT_MCP_PORT=8066
DATAAGENT_MCP_TRANSPORT=streamable-http
DATAAGENT_MCP_STREAMABLE_HTTP_PATH=/mcp
DATAAGENT_MCP_SSE_PATH=/sse
DATAAGENT_MCP_MESSAGE_PATH=/mcp/message
## Multi-dataset BI. Point to EXISTING files; no automatic downloads/imports.
# DATAAGENT_SCANIA_DATA_DIR=/path/to/scania/_component/_x
# Docker BI preview bind mount requires an absolute source path on the host.
# DATAAGENT_SCANIA_HOST_DATA_DIR=/absolute/path/to/scania/_component/_x
DATAAGENT_BI_QUERY_TIMEOUT_SECONDS=60
DATAAGENT_BI_TASK_TIMEOUT_SECONDS=600
DATAAGENT_BI_MAX_CONCURRENCY=2
DATAAGENT_BI_MEMORY_LIMIT_MB=512
